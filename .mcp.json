{
  "mcpServers": {
    "pagelayer-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@automattic/mcp-wordpress-remote"],
      "env": {
        "WP_API_URL": "https://virtuotechservices.com/wp-json/mcp/mcp-adapter-default-server",
        "WP_API_USERNAME": "${WP_API_USERNAME:-admin}",
        "WP_API_PASSWORD": "${WP_API_PASSWORD:-injected-by-network-secret}"
      }
    }
  }
}
